  COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/scripts/c0au#at1.baf~
COPY ~%MOD_FOLDER%/creatures/c0au#at1.cre~ ~override~
WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~C0_AUTOCANNON~))
WRITE_ASCII SCRIPT_DEFAULT ~c0au#at1~  // override
WRITE_ASCII DEATHVAR ~c0au#at1~ // death variable
SAY NAME1 ~兰坦自动炮~
SAY NAME2 ~兰坦自动炮~

ADD_PROJECTILE ~%MOD_FOLDER%/spells/pro/c0au#sp2.PRO~
COPY_EXISTING ~c0au#s1.spl~ ~override~
SAY NAME1 ~制造自动炮~
SAY UNIDENTIFIED_DESC ~制造自动炮
兰坦自动炮是受过魔法训练的工匠造出的武器化装置。它以耐用金属制成，机动性不足，却以威力弥补：向敌人高速倾泻火焰弹，是很有价值的防御武器。由于加在自动炮上的附魔，它一旦感知到创造者的敌人就会启动，随后不停攻击，直到驱动它的魔法耗尽。设计高效，因此自动炮便于携带、可快速架设。

借由此能力，工匠可以尝试在目标地点制造一具兰坦自动炮。成败取决于工匠的「设置陷阱」技能。敌对生物进入射程时自动炮即启动。自动炮不能移动，每轮攻击五次，发射火焰弹，每发造成 1d3+1 伤害，附魔 +6。自动机每轮有 5% 几率充能，获得命中值 +4，并在六秒内攻击次数加倍。

工匠的「设置陷阱」每高出 100 点 15 点，自动炮就获得命中值 +1 与额外 5 点生命值。

一旦启动，自动炮持续两回合。~
COPY_EXISTING ~c0au#s2.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0au#sp2%~
END
